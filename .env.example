# ---- BACKEND (server/index.js) — set these on Render as Environment Variables ----
# Never put these in frontend code or commit them to git

ANTHROPIC_API_KEY=your_anthropic_api_key_here
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here

# ---- FRONTEND (Vite) — these get baked into the JS bundle at build time ----
# Safe to expose — these are public-facing IDs, not secrets

# Your Render backend URL (e.g. https://exitus-api.onrender.com)
VITE_API_URL=https://your-render-backend-url.onrender.com

# Your Stripe $29/mo Price ID from Stripe dashboard
VITE_STRIPE_PRICE_ID=price_your_stripe_price_id_here
