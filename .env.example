# ---- BACKEND (server/index.js) — set these on Render as Environment Variables ----
# Never put these in frontend code or commit them to git

ANTHROPIC_API_KEY=your_anthropic_api_key_here
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here
# Signing secret from the Stripe webhook you create (starts with whsec_)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret_here
# Supabase SECRET key (sb_secret_...). Backend only — lets the webhook write
# subscription status. NEVER expose this in frontend code.
SUPABASE_SECRET_KEY=sb_secret_your_supabase_secret_key_here
SUPABASE_URL=https://your-project-ref.supabase.co

# ---- FRONTEND (Vite) — these get baked into the JS bundle at build time ----
# Safe to expose — these are public-facing IDs, not secrets

# Your Render backend URL (e.g. https://exitus-api.onrender.com)
VITE_API_URL=https://your-render-backend-url.onrender.com

# Your Stripe monthly Price ID from Stripe dashboard
VITE_STRIPE_PRICE_ID=price_your_monthly_price_id_here
# Your Stripe annual Price ID
VITE_STRIPE_PRICE_ANNUAL=price_your_annual_price_id_here

# Supabase project URL and PUBLISHABLE key (sb_publishable_...) — safe in frontend
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key_here
