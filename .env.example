# Anthropic API Key - set this in Netlify environment variables, NOT in frontend code
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Stripe Secret Key - set this in Netlify environment variables, NOT in frontend code
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key_here

# Stripe Price ID for the $29/mo Nomad plan - safe to expose in frontend
VITE_STRIPE_PRICE_ID=price_your_stripe_price_id_here
